# BytePro API Credentials
# Copy this file to .env and fill in your values
# NEVER commit the .env file!

BYTEPRO_BASE_URL=https://your-company.bytepro.com
BYTEPRO_API_KEY=your-api-key-here
BYTEPRO_USERNAME=your-api-username
BYTEPRO_PASSWORD=your-api-password

# SMTP (for sending lender order emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourcompany.com
SMTP_MOCK=true

# GHL CRM
GHL_ACCESS_TOKEN=your-ghl-token
GHL_MOCK=true
